# Copy this file to .env.local and fill in the values

# Your Formspree form ID — get it from https://formspree.io
# e.g. NEXT_PUBLIC_FORMSPREE_ID=xrgvwnkb
NEXT_PUBLIC_FORMSPREE_ID=

# Your live site URL — used by sitemap.xml and robots.txt
# Use your CloudFront URL until a custom domain is set up
# e.g. NEXT_PUBLIC_SITE_URL=https://d1234abcd.cloudfront.net
NEXT_PUBLIC_SITE_URL=
